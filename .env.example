# Copy to .env and fill in. Never commit .env.
TAVILY_API_KEY=
# Key for whichever LLM provider you use (OpenAI, Anthropic, ...)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: trace every run in LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Linux only: run the container as your user so ./data is writable (id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# Optional: override the model names from config.toml. Leave empty to use the config file.
# JOBAGENT_MODEL applies to every step; the others to one step only and win over it.
JOBAGENT_MODEL=
JOBAGENT_QUERY_MODEL=
JOBAGENT_EXTRACT_MODEL=
JOBAGENT_SCORE_MODEL=
JOBAGENT_PARSE_MODEL=
