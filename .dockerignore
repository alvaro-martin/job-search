# Version control and editors
.git
.gitignore
.vscode
.idea

# Python / tooling
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
**/*.egg-info

# Secrets and personal data: never bake these into the image
.env
.env.*
**/*.db
src/jobagent/data/*
!src/jobagent/data/config.example.toml
!src/jobagent/data/example.profile.json

# Not needed at runtime
tests
README.md
LICENSE
Dockerfile
docker-compose.yml
.dockerignore
